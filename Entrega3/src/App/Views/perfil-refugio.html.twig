{% extends 'layout/base.html.twig' %}

{% block title %}Mi Perfil - PawMap{% endblock %}

{% block main_attributes %}class="perfil-refugio-container {{ errores is not empty ? 'is-editing' : '' }}"{% endblock %}

{% block main %}
    <section class="perfil-refugio-header">
        <figure class="perfil-avatar-wrapper perfil-refugio-avatar">
            {% set fotoPerfil = user.foto_perfil|default('') %}
            {% set avatarUrl = fotoPerfil is not empty ? (fotoPerfil starts with 'http' ? fotoPerfil : '/assets/img/' ~ fotoPerfil) : '' %}
            
            <span id="preview-placeholder" class="avatar-placeholder {{ avatarUrl is not empty ? 'hidden' : '' }}">
                <span class="material-symbols-outlined">person</span>
            </span>
            
            <img id="image-preview" src="{{ avatarUrl }}" data-original="{{ avatarUrl }}" alt="Foto de perfil" class="{{ avatarUrl is empty ? 'hidden' : '' }}">
            
            <figcaption class="avatar-hover-overlay">
                <span class="material-symbols-outlined">photo_camera</span>
            </figcaption>
        </figure>

        <h1>Hola, {{ user.nombre_usuario }}!</h1>
        <p class="perfil-refugio-email">{{ user.email|default('') }}</p>
        <a href="/logout" class="perfil-refugio-logout">
            <span class="material-symbols-outlined">logout</span>
            Cerrar sesión
        </a>
    </section>

    <section class="perfil-refugio-datos">
        <header class="perfil-refugio-datos-header">
            <h2>Datos del Refugio</h2>
            <button type="button" id="btn-edit-refugio" class="btn-editar" title="Editar datos">
                <span class="material-symbols-outlined">edit_square</span>
            </button>
        </header>
        <article class="perfil-refugio-datos-body">
            <form id="perfil-refugio-form" class="perfil-refugio-form" method="POST" action="/perfil/refugio/guardar" enctype="multipart/form-data" novalidate>
                <input type="file" id="foto_perfil_o_logo" name="foto_perfil_o_logo" accept="image/*" class="hidden-input" data-max-file-size="2097152" data-max-file-message="La imagen no puede superar los 2 MB.">
                <input type="hidden" id="eliminar_foto" name="eliminar_foto" value="0">
                
                {% if errores.foto_perfil_o_logo is defined %}
                    <aside class="alerta-error alerta-espaciada" role="alert">
                        <span class="material-symbols-outlined">error</span>
                        <section>
                            <strong>Error con la foto de perfil:</strong>
                            <p>{{ errores.foto_perfil_o_logo }}</p>
                        </section>
                    </aside>
                {% endif %}

                <fieldset class="perfil-refugio-datos-columnas">
                    <ul class="columna-datos">
                        <li class="dato-refugio-item">
                            <label class="dato-refugio-label" for="nombre_institucion">Nombre de la institución:</label>
                            <p class="dato-refugio-valor static-value">{{ refugio.nombre_institucion|default('—') }}</p>
                            <input type="text" id="nombre_institucion" name="nombre_institucion" value="{{ oldData.nombre_institucion|default(refugio.nombre_institucion|default('')) }}" data-original="{{ refugio.nombre_institucion|default('') }}" class="dato-valor-input input-value {{ errores.nombre_institucion is defined ? 'input-invalido' : '' }}" minlength="2" maxlength="100" required>
                            {% if errores.nombre_institucion is defined %}
                                <span class="msg-error input-value">{{ errores.nombre_institucion }}</span>
                            {% endif %}
                        </li>
                        <li class="dato-refugio-item">
                            <label class="dato-refugio-label" for="telefono">Teléfono:</label>
                            <p class="dato-refugio-valor static-value">{{ refugio.telefono|default('—') }}</p>
                            <input type="tel" id="telefono" name="telefono" value="{{ oldData.telefono|default(refugio.telefono|default('')) }}" data-original="{{ refugio.telefono|default('') }}" class="dato-valor-input input-value {{ errores.telefono is defined ? 'input-invalido' : '' }}" minlength="6" maxlength="20" pattern="^\+?[0-9\s\-]{6,20}$">
                            {% if errores.telefono is defined %}
                                <span class="msg-error input-value">{{ errores.telefono }}</span>
                            {% endif %}
                        </li>
                        <li class="dato-refugio-item">
                            <label class="dato-refugio-label" for="alias">Alias:</label>
                            <p class="dato-refugio-valor static-value">{{ refugio.alias|default('—') }}</p>
                            <input type="text" id="alias" name="alias" value="{{ oldData.alias|default(refugio.alias|default('')) }}" data-original="{{ refugio.alias|default('') }}" class="dato-valor-input input-value {{ errores.alias is defined ? 'input-invalido' : '' }}" minlength="4" maxlength="40">
                            {% if errores.alias is defined %}
                                <span class="msg-error input-value">{{ errores.alias }}</span>
                            {% endif %}
                        </li>
                    </ul>
                    <ul class="columna-datos">
                        <li class="dato-refugio-item">
                            <label class="dato-refugio-label" for="descripcion">Descripción:</label>
                            <article class="static-value dato-refugio-descripcion-container">
                                <p class="dato-refugio-valor descripcion-texto">{{ refugio.descripcion|default('-')|nl2br }}</p>
                                <button type="button" class="btn-ver-mas-desc hidden-desc">Ver más</button>
                            </article>
                            <input type="text" id="descripcion" name="descripcion" value="{{ oldData.descripcion|default(refugio.descripcion|default('')) }}" data-original="{{ refugio.descripcion|default('') }}" class="dato-valor-input input-value {{ errores.descripcion is defined ? 'input-invalido' : '' }}" maxlength="500">
                            {% if errores.descripcion is defined %}
                                <span class="msg-error input-value">{{ errores.descripcion }}</span>
                            {% endif %}
                        </li>
                        <li class="dato-refugio-item">
                            <label class="dato-refugio-label" for="email">Mail:</label>
                            <p class="dato-refugio-valor static-value">{{ user.email|default('—') }}</p>
                            <input type="email" id="email" name="email" value="{{ oldData.email|default(user.email|default('')) }}" data-original="{{ user.email|default('') }}" class="dato-valor-input input-value {{ errores.email is defined ? 'input-invalido' : '' }}" required>
                            {% if errores.email is defined %}
                                <span class="msg-error input-value">{{ errores.email }}</span>
                            {% endif %}
                        </li>
                        <li class="dato-refugio-item">
                            <label class="dato-refugio-label" for="cvu">CVU:</label>
                            <p class="dato-refugio-valor static-value">{{ refugio.cvu|default('—') }}</p>
                            <input type="text" id="cvu" name="cvu" value="{{ oldData.cvu|default(refugio.cvu|default('')) }}" data-original="{{ refugio.cvu|default('') }}" class="dato-valor-input input-value {{ errores.cvu is defined ? 'input-invalido' : '' }}" minlength="22" maxlength="22" pattern="^[0-9]{22}$">
                            {% if errores.cvu is defined %}
                                <span class="msg-error input-value">{{ errores.cvu }}</span>
                            {% endif %}
                        </li>
                    </ul>
                </fieldset>
                <footer class="perfil-datos-acciones input-value">
                    <button type="submit" class="btn-guardar-perfil">Guardar</button>
                    <button type="button" id="btn-cancel-refugio" class="btn-cancelar-perfil">Cancelar</button>
                </footer>
            </form>

        </article>
    </section>

    <!-- Navegación ancla (sticky) -->
    <nav class="perfil-refugio-nav">
        <a href="#sec-solicitudes-adopcion">
            <span class="material-symbols-outlined">assignment</span>
            Gestión de solicitudes
        </a>
        <a href="#sec-monitoreo">
            <span class="material-symbols-outlined">monitor_heart</span>
            Monitoreo Post-Adopción
        </a>
        <a href="#sec-ubicacion">
            <span class="material-symbols-outlined">location_on</span>
            Ubicación: Agregar/Modificar
        </a>
        <a href="#sec-publicar">
            <span class="material-symbols-outlined">pets</span>
            Publicar Mascota
        </a>
        <a href="#sec-editar-mascota">
            <span class="material-symbols-outlined">refresh</span>
            Actualizar / Eliminar Mascota
        </a>
        <a href="#sec-mascotas-adoptadas">
            <span class="material-symbols-outlined">volunteer_activism</span>
            Mascotas Adoptadas
        </a>
    </nav>
    
    <!-- Sección: Solicitudes -->
     <section class="perfil-refugio-seccion" id="sec-solicitudes-adopcion">
        <details class="perfil-dropdown">
        <summary> <h3>Solicitudes de adopción</h3> </summary>
        {% if solicitudes is empty %}
            <article class="perfil-refugio-vacio">
                <span class="material-symbols-outlined">mail</span>
                <p>Todavía no recibiste solicitudes de adopción.</p>
            </article>
        {% else %}
            <ul class="perfil-refugio-lista-adopcion">
                {% for sol in solicitudes %}
                    {% set estadoSol = sol.estado|default('PENDIENTE')|upper %}
                    {% set disabled = (estadoSol != 'PENDIENTE') ? 'disabled' : '' %}
                    {% set estadoClass = 'estado-' ~ estadoSol|lower %}
                    
                    <li class="perfil-lista-item-adopcion" data-id="{{ sol.id }}">
                        <h4>
                            {{ sol.mascota_nombre|default('Mascota') }}
                            por {{ sol.adoptante_nombre|default('—') }}
                            {{ sol.adoptante_apellido|default('—') }}
                        </h4>
                        <mark class="estado-solicitud {{ estadoClass }}">
                            Estado: {{ sol.estado|default('—') }}  <br>
                            Fecha: {{ sol.fecha|default('—') }}
                        </mark>
                        <p>
                            Detalle de la mascota: <br>
                            {{ sol.edad|default('?') }} año(s)
                            · {{ sol.tamano|default('—') }}
                            · {{ sol.temperamento|default('—') }}
                        </p>
                        {% if estadoSol == 'PENDIENTE' %}
                            <button class="btn-rechazar" data-id="{{ sol.id }}">RECHAZAR</button>
                            <button class="btn-aceptar" data-id="{{ sol.id }}">ACEPTAR</button>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        </details>
    </section>

    <section class="perfil-refugio-seccion" id="sec-monitoreo">
        <details class="perfil-dropdown">
        <summary> <h3>Monitoreo Post-Adopción</h3> </summary>
        
        {% if seguimientoAgrupado is empty %}
            <article class="perfil-refugio-vacio">
                <span class="material-symbols-outlined">pets</span>
                <p>Aún no hay seguimientos para mascotas adoptadas.</p>
            </article>
        {% else %}
            <ul class="monitoreo-lista-mascotas">
                {% for mascotaId, datos in seguimientoAgrupado %}
                    <li class="monitoreo-item-mascota">
                        <details class="perfil-dropdown mascota-seguimiento-dropdown">
                            <summary class="mascota-seguimiento-summary">
                                <h4>
                                    {{ datos.mascota_nombre }} 
                                    <small>(Adoptante: {{ datos.adoptante_nombre }})</small>
                                </h4>
                            </summary>
                            
                            <article class="mascota-seguimiento-contenido">
                                <h5 class="monitoreo-subtitle">Encuestas</h5>
                                {% if datos.encuestas is empty %}
                                    <p class="text-muted">No hay encuestas respondidas aún.</p>
                                {% else %}
                                    <ul class="monitoreo-lista-encuestas">
                                        {% for enc in datos.encuestas %}
                                            {% set alertaClass = enc.alerta_generada ? 'encuesta-alerta' : 'encuesta-ok' %}
                                            <li class="monitoreo-item-encuesta {{ alertaClass }}">
                                                <header class="encuesta-header">
                                                    <mark class="encuesta-etapa badge-{{ enc.etapa }}">Etapa: {{ enc.etapa|replace({'_': ' '}) }}</mark>
                                                    <span class="encuesta-fecha">{{ enc.fecha_encuesta|date('d/m/Y') }}</span>
                                                </header>
                                                <details class="encuesta-detalles">
                                                    <summary>Ver respuestas completas</summary>
                                                    <article class="encuesta-respuestas-grid">
                                                        {% if enc.conducta is not empty %}
                                                            <p><strong>Conducta:</strong> {{ enc.conducta }}</p>
                                                        {% endif %}
                                                        {% if enc.sueno is not empty %}
                                                            <p><strong>Sueño:</strong> {{ enc.sueno }}</p>
                                                        {% endif %}
                                                        {% if enc.alimentacion is not empty %}
                                                            <p><strong>Alimentación:</strong> {{ enc.alimentacion }}</p>
                                                        {% endif %}
                                                        {% if enc.progreso_general is not empty %}
                                                            <p><strong>Progreso general:</strong> {{ enc.progreso_general }}</p>
                                                        {% endif %}
                                                        {% if enc.comentarios is not empty %}
                                                            <p class="encuesta-comentarios"><strong>Comentarios:</strong> <br>{{ enc.comentarios|nl2br }}</p>
                                                        {% endif %}
                                                    </article>
                                                </details>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}

                                <h5 class="monitoreo-subtitle mt-2">Fotos y Archivos de Seguimiento</h5>
                                {% if datos.fotos is empty %}
                                    <p class="text-muted">No se han subido fotos ni certificados aún.</p>
                                {% else %}
                                    <ul class="monitoreo-galeria-fotos">
                                        {% for foto in datos.fotos %}
                                            {% set docUrl = foto.url starts with 'http' ? foto.url : '/' ~ foto.url|trim('/') %}
                                            <li class="foto-item">
                                                <a href="{{ docUrl }}" target="_blank" class="foto-link">
                                                    <figure class="monitoreo-foto-figure">
                                                        {% if foto.tipo == 'certificado_med' or foto.tipo == 'certificado_vac' %}
                                                            <span class="monitoreo-doc-placeholder">
                                                                <span class="material-symbols-outlined">description</span>
                                                            </span>
                                                        {% else %}
                                                            <figure class="monitoreo-preview">
                                                                <img src="{{ docUrl }}" alt="Seguimiento {{ foto.mascota_nombre }}" class="monitoreo-img">
                                                            </figure>
                                                        {% endif %}
                                                        <figcaption class="monitoreo-foto-info">
                                                            <span class="monitoreo-foto-tipo">
                                                                {% if foto.tipo == 'certificado_med' %}
                                                                    Certificado Médico
                                                                {% elseif foto.tipo == 'certificado_vac' %}
                                                                    Certificado de Vacunación
                                                                {% else %}
                                                                    Foto
                                                                {% endif %}
                                                            </span>
                                                        </figcaption>
                                                    </figure>
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </article>
                        </details>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        </details>
    </section>
    
    <section class="perfil-refugio-ubicacion" id="sec-ubicacion">
        <details class="perfil-dropdown">
            <summary> <h3>Ubicación: Agregar/Modificar</h3> </summary>

        <article class="perfil-refugio-ubicacion-content">
            {% if refugio.ciudad is not empty and refugio.provincia is not empty %}
                <article class="ubicacion-actual-box">
                    <span class="material-symbols-outlined icono-pin-actual">where_to_vote</span>
                    <p class="ubicacion-actual-text">
                        <span class="label-ubicacion">Ubicación guardada:</span>
                        <strong class="valor-ubicacion">{{ refugio.direccion|default(refugio.ciudad ~ ', ' ~ refugio.provincia) }}</strong>
                    </p>
                </article>
            {% endif %}

            <form action="/perfil/refugio/ubicacion" method="POST" id="form-ubicacion-refugio" class="form-ubicacion-premium">
                <fieldset class="grupo-input-ubicacion">
                    <label for="ubicacion-autocomplete" class="label-buscar-ubicacion">¿Te mudaste? Buscá la nueva dirección:</label>
                    <section class="input-wrapper-premium">
                        <input type="text" id="ubicacion-autocomplete" class="input-ubicacion-premium" placeholder="Ej: Av. Rivadavia 1234, Buenos Aires..." autocomplete="off" required>
                        <ul id="sugerencias-ubicacion" class="sugerencias-ubicacion-premium"></ul>
                    </section>
                </fieldset>
                
                <input type="hidden" name="latitud" id="ubi_lat">
                <input type="hidden" name="longitud" id="ubi_lon">
                <input type="hidden" name="ciudad" id="ubi_ciudad">
                <input type="hidden" name="provincia" id="ubi_provincia">
                <input type="hidden" name="pais" id="ubi_pais">
                <input type="hidden" name="direccion" id="ubi_direccion">
                
                <footer class="acciones-ubicacion-premium">
                    <button type="submit" class="btn-primario btn-guardar-premium" id="btn-guardar-ubicacion" disabled>
                        Guardar Cambios
                    </button>
                </footer>
            </form>
        </article>
        </details>
    </section>

    <section class="perfil-refugio-publicar" id="sec-publicar">
        <details class="perfil-dropdown">
        <summary> <h3>Publicar Mascota</h3> </summary>
        <p>Agrega los datos de la nueva mascota:</p>
    
        <form id="form-publicar-mascota" method="POST" action="/perfil/mascota/publicar" enctype="multipart/form-data">
            <label for="nombre">Nombre
            <input type="text" id="nombre" name="nombre" placeholder="Ingresá el nombre de la mascota"
                value="{{ oldMascota.nombre|default('') }}"
                minlength="2"
                maxlength="60"
                pattern="^[A-Za-zÁÉÍÓÚáéíóúÑñ\s'-]+$"
                required
                data-trim-required="true"
                title="Solo se permiten letras, espacios, apóstrofes y guiones."
                {{ erroresMascota.nombre is defined and erroresMascota.nombre is not empty ? 'data-server-error="' ~ erroresMascota.nombre ~ '"' : '' }}>
            </label>
            
            <fieldset class="publicar-mascota-grupo">
                <legend>Especie</legend>
                {% set errorEspecie = erroresMascota.especie|default('') %}
                {% for e in especies %}
                    <label class="especie-refugio-radio">
                        <input type="radio" name="especie" value="{{ e.fields.especie }}"
                               required
                               {{ (oldMascota.especie|default('') == e.fields.especie) ? 'checked' : '' }}
                               {{ errorEspecie is not empty ? 'data-server-error="' ~ errorEspecie ~ '"' : '' }}>
                        <span>{{ e.fields.especie|capitalize }}</span>
                    </label>
                    {% set errorEspecie = '' %}
                {% endfor %}
            </fieldset>
            
            <label for="fecha_nacimiento">Fecha de nacimiento
            <input type="date" id="fecha_nacimiento" name="fecha_nacimiento"
                value="{{ oldMascota.fecha_nacimiento|default('') }}"
                max="{{ 'now'|date('Y-m-d') }}"
                min="{{ '-30 years'|date('Y-m-d') }}"
                data-no-future="true"
                data-future-message="La fecha de nacimiento no puede ser futura."
                {{ erroresMascota.fecha_nacimiento is defined and erroresMascota.fecha_nacimiento is not empty ? 'data-server-error="' ~ erroresMascota.fecha_nacimiento ~ '"' : '' }}>
            </label>

            <label for="descripcion_mascota">Descripción
            <textarea id="descripcion_mascota" name="descripcion_mascota" placeholder="Ingresá una descripción de la mascota" maxlength="500" {{ erroresMascota.descripcion_mascota is defined and erroresMascota.descripcion_mascota is not empty ? 'data-server-error="' ~ erroresMascota.descripcion_mascota ~ '"' : '' }}>{{ oldMascota.descripcion_mascota|default('') }}</textarea>
            </label>

            <label for="tamanio">Tamaño
            <select id="tamanio" name="tamanio" required {{ erroresMascota.tamanio is defined and erroresMascota.tamanio is not empty ? 'data-server-error="' ~ erroresMascota.tamanio ~ '"' : '' }}>
                <option value="">Seleccioná un tamaño</option>
                {% for t in tamanos %}
                    <option value="{{ t.fields.tamano }}" {{ (oldMascota.tamanio|default('') == t.fields.tamano) ? 'selected' : '' }}>
                        {{ t.fields.tamano|capitalize }}
                    </option>
                {% endfor %}
            </select>
            </label>

            <label for="sexo">Sexo
            <select id="sexo" name="sexo" required {{ erroresMascota.sexo is defined and erroresMascota.sexo is not empty ? 'data-server-error="' ~ erroresMascota.sexo ~ '"' : '' }}>
                <option value="macho" {{ (oldMascota.sexo|default('') == 'macho') ? 'selected' : '' }}>Macho</option>
                <option value="hembra" {{ (oldMascota.sexo|default('') == 'hembra') ? 'selected' : '' }}>Hembra</option>
            </select>
            </label>

            <label for="temperamento">Temperamento
            <select id="temperamento" name="temperamento" required {{ erroresMascota.temperamento is defined and erroresMascota.temperamento is not empty ? 'data-server-error="' ~ erroresMascota.temperamento ~ '"' : '' }}>
                <option value="">Seleccioná un temperamento</option>
                {% for t in temperamentos %}
                    <option value="{{ t.fields.temperamento }}" {{ (oldMascota.temperamento|default('') == t.fields.temperamento) ? 'selected' : '' }}>
                        {{ t.fields.temperamento|capitalize }}
                    </option>
                {% endfor %}
            </select>
            </label>

            <label for="esterilizado">¿Está esterilizado?
            <select id="esterilizado" name="esterilizado" required {{ erroresMascota.esterilizado is defined and erroresMascota.esterilizado is not empty ? 'data-server-error="' ~ erroresMascota.esterilizado ~ '"' : '' }}>
                <option value="si" {{ (oldMascota.esterilizado|default('') == 'si') ? 'selected' : '' }}>Sí</option>
                <option value="no" {{ (oldMascota.esterilizado|default('no') != 'si') ? 'selected' : '' }}>No</option>
            </select>
            </label>

            <label for="foto">Foto <small>(opcional, máx. 2 MB — JPG, PNG, WEBP)</small>
            <input type="file" id="foto" name="foto" accept="image/jpeg,image/png,image/webp"
                data-max-file-size="2097152"
                data-max-file-message="La imagen no puede superar 2 MB."
                data-file-types-message="Archivo no válido. Solo JPG, PNG o WEBP."
                {{ erroresMascota.foto is defined and erroresMascota.foto is not empty ? 'data-server-error="' ~ erroresMascota.foto ~ '"' : '' }}>
            </label>

            <label for="svg">Ilustración SVG <small>(opcional — archivo .svg)</small>
            <input type="file" id="svg" name="svg" accept="image/svg+xml,.svg"
                data-file-types-message="Solo se permiten archivos .svg."
                {{ erroresMascota.svg is defined and erroresMascota.svg is not empty ? 'data-server-error="' ~ erroresMascota.svg ~ '"' : '' }}>
            </label>

            <footer class="form-acciones">
                <button type="submit" id="btn-publicar-mascota" class="btn-publicar-mascota">Publicar</button>
                <button type="button" id="btn-cancelar-publicar" class="btn-cancelar-publicar-mascota">Cancelar</button>
            </footer>
        </form>
        </details>
    </section>    <section class="perfil-editar-mascota sec-editar-mascota" id="sec-editar-mascota">
        <details class="perfil-dropdown">
        <summary> <h3>Actualizar/Eliminar Mascota</h3> </summary>
        {% if mascotas is empty %}
            <article class="perfil-vacio">
                <span class="material-symbols-outlined">pets</span>
                <p>Todavía no tenés mascotas publicadas.</p>
            </article>
        {% else %}
            <ul class="perfil-refugio-grid">
                {% for mascota in mascotas %}
                    <li class="tarjeta-refugio-mascota">
                        <a href="/mascota?id={{ mascota.fields.id }}" class="tarjeta-refugio-mascota-link" title="Ver detalle de {{ mascota.fields.nombre|default('Mascota') }}">
                            <h4>{{ mascota.fields.nombre|default('Sin nombre') }}</h4>
                            <p>
                                {{ mascota.fields.edad|default('?') }} año(s)
                                · {{ mascota.fields.tamano|default('—') }}
                                · {{ mascota.fields.temperamento|default('—') }}
                            </p>
                        </a>
                        <a href="/mascota/editar?id={{ mascota.fields.id }}" class="btn-editar" title="Editar datos">
                           <span class="material-symbols-outlined">edit_square</span>
                       </a>
                        <form method="POST" action="/perfil/eliminar" class="form-eliminar-mascota">
                            <input type="hidden" name="id" value="{{ mascota.fields.id }}">
                            <button type="submit" class="btn-eliminar-mascota" title="Eliminar mascota">
                                <span class="material-symbols-outlined">delete</span>
                            </button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        </details>
    </section>

    <section class="perfil-editar-mascota sec-mascotas-adoptadas" id="sec-mascotas-adoptadas">
        <details class="perfil-dropdown">
        <summary> <h3>Mascotas Adoptadas</h3> </summary>
        {% if mascotasAdoptadas is empty %}
            <article class="perfil-vacio">
                <span class="material-symbols-outlined">volunteer_activism</span>
                <p>Todavía no tenés mascotas adoptadas.</p>
            </article>
        {% else %}
            <ul class="perfil-refugio-grid">
                {% for mascota in mascotasAdoptadas %}
                    <li class="tarjeta-refugio-mascota">
                        <a href="/mascota?id={{ mascota.fields.id }}" class="tarjeta-refugio-mascota-link" title="Ver detalle de {{ mascota.fields.nombre|default('Mascota') }}">
                            <h4>{{ mascota.fields.nombre|default('Sin nombre') }}</h4>
                            <p>
                                {{ mascota.fields.edad|default('?') }} año(s)
                                · {{ mascota.fields.tamano|default('—') }}
                                · {{ mascota.fields.temperamento|default('—') }}
                            </p>
                        </a>
                        <a href="/mascota/libreta?id={{ mascota.fields.id }}" class="btn-editar btn-libreta" title="Ver Libreta Sanitaria">
                           <span class="material-symbols-outlined">medical_information</span>
                       </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        </details>
    </section>

    <section class="sec-estadisticas" id="sec-estadisticas">
        <h2 class="estadisticas-main-title">Métricas y Estadísticas del Refugio</h2>
                        <section class="perfil-stats-dashboard">
                
                <section class="kpi-container">
                    <article class="kpi-card">
                        <span class="material-symbols-outlined kpi-icon">pets</span>
                        <section class="kpi-data">
                            <h4 class="kpi-title">Total Mascotas</h4>
                            <span class="kpi-value">{{ estadisticas.kpis.totalMascotas|default(0) }}</span>
                        </section>
                    </article>
                    <article class="kpi-card">
                        <span class="material-symbols-outlined kpi-icon">volunteer_activism</span>
                        <section class="kpi-data">
                            <h4 class="kpi-title">Adopciones Exitosas</h4>
                            <span class="kpi-value">{{ estadisticas.kpis.adopcionesExitosas|default(0) }}</span>
                        </section>
                    </article>
                    <article class="kpi-card">
                        <span class="material-symbols-outlined kpi-icon">mail</span>
                        <section class="kpi-data">
                            <h4 class="kpi-title">Solicitudes Recibidas</h4>
                            <span class="kpi-value">{{ estadisticas.kpis.totalSolicitudes|default(0) }}</span>
                        </section>
                    </article>
                </section>

                <section class="dashboard-grid">
                    
                    <figure class="paw-chart">
                        <figcaption><h3>Estado de Adopciones</h3></figcaption>
                        {% if estadisticas.estado is empty or estadisticas.kpis.totalMascotas == 0 %}
                            <p class="paw-chart-empty">No hay datos a�n.</p>
                        {% else %}
                            <dl class="paw-chart-list">
                                {% for key, count in estadisticas.estado %}
                                    {% set percent = (count / estadisticas.kpis.totalMascotas * 100)|round %}
                                    <dt>{{ key }} ({{ count }})</dt>
                                        <dd><span class="paw-chart-bar" style="--percent: {{ percent }}%;"></span></dd>
                                {% endfor %}
                            </dl>
                        {% endif %}
                    </figure>

                    <figure class="paw-chart paw-pie-container">
                        <figcaption><h3>Mascotas por Especie</h3></figcaption>
                        {% if estadisticas.especie is empty or estadisticas.kpis.totalMascotas == 0 %}
                            <p class="paw-chart-empty">No hay datos a�n.</p>
                        {% else %}
                            <section class="paw-js-pie-chart" data-chart-data="{{ estadisticas.especie|json_encode|e('html_attr') }}" data-chart-type="doughnut">
                                <p class="paw-chart-loading">Cargando gr�fico interactivo...</p>
                            </section>
                        {% endif %}
                    </figure>

                    <figure class="paw-chart paw-pie-container">
                        <figcaption><h3>Tamaño de Mascotas</h3></figcaption>
                        {% if estadisticas.tamano is empty or estadisticas.kpis.totalMascotas == 0 %}
                            <p class="paw-chart-empty">No hay datos a�n.</p>
                        {% else %}
                            <section class="paw-js-pie-chart" data-chart-data="{{ estadisticas.tamano|json_encode|e('html_attr') }}" data-chart-type="pie">
                                <p class="paw-chart-loading">Cargando gr�fico interactivo...</p>
                            </section>
                        {% endif %}
                    </figure>

                    <figure class="paw-chart">
                        <figcaption><h3>Temperamento</h3></figcaption>
                        {% if estadisticas.temperamento is empty or estadisticas.kpis.totalMascotas == 0 %}
                            <p class="paw-chart-empty">No hay datos a�n.</p>
                        {% else %}
                            <dl class="paw-chart-list">
                                {% for key, count in estadisticas.temperamento %}
                                    {% set percent = (count / estadisticas.kpis.totalMascotas * 100)|round %}
                                    <dt>{{ key }} ({{ count }})</dt>
                                        <dd><span class="paw-chart-bar" style="--percent: {{ percent }}%;"></span></dd>
                                {% endfor %}
                            </dl>
                        {% endif %}
                    </figure>

                    <figure class="paw-chart paw-pie-container">
                        <figcaption><h3>Estado de Solicitudes</h3></figcaption>
                        {% if estadisticas.solicitudes is empty or estadisticas.kpis.totalSolicitudes == 0 %}
                            <p class="paw-chart-empty">No hay datos a�n.</p>
                        {% else %}
                            <section class="paw-js-pie-chart" data-chart-data="{{ estadisticas.solicitudes|json_encode|e('html_attr') }}" data-chart-type="pie">
                                <p class="paw-chart-loading">Cargando gr�fico interactivo...</p>
                            </section>
                        {% endif %}
                    </figure>

                    <figure class="paw-chart paw-pie-container">
                        <figcaption><h3>Castrados / Esterilizados</h3></figcaption>
                        {% if estadisticas.castrado is empty or estadisticas.kpis.totalMascotas == 0 %}
                            <p class="paw-chart-empty">No hay datos a�n.</p>
                        {% else %}
                            <section class="paw-js-pie-chart" data-chart-data="{{ estadisticas.castrado|json_encode|e('html_attr') }}" data-chart-type="pie">
                                <p class="paw-chart-loading">Cargando gr�fico interactivo...</p>
                            </section>
                        {% endif %}
                    </figure>

                </section>
            </section>
    </section>
    <dialog id="modal-confirmar-eliminar" class="modal-nativo modal-confirmacion">
        <header>
            <h2>Confirmar eliminación</h2>
        </header>
        <section class="modal-body">
            <p>¿Estás seguro de que deseas eliminar esta mascota? Esta acción no se puede deshacer.</p>
        </section>
        <footer class="acciones-modal">
            <button type="button" class="btn-cancelar js-cerrar-modal" id="btn-cancelar-eliminar">Cancelar</button>
            <button type="button" class="btn-eliminar-confirmado" id="btn-confirmar-eliminar">Eliminar</button>
        </footer>
    </dialog>

    
{% endblock %}

{% block content_after_main %}
