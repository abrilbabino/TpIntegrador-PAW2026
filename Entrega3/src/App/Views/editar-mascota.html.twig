{% extends 'layout/base.html.twig' %}

{% set mascotaFields = mascota.fields|default([]) %}
{% set nombreActual = oldData.nombre|default(mascotaFields.nombre|default('')) %}
{% set especieActual = (oldData.especie|default(mascotaFields.especie|default('')))|lower %}
{% set tamanioActual = (oldData.tamanio|default(oldData.tamano|default(mascotaFields.tamano|default(''))))|lower %}
{% set temperamentoActual = (oldData.temperamento|default(mascotaFields.temperamento|default('')))|lower %}
{% set sexoActual = (oldData.sexo|default(mascotaFields.sexo|default('')))|lower %}
{% set esterilizadoActual = oldData.esterilizado|default((mascotaFields.castrado|default(0) == 1) ? 'si' : 'no') %}
{% set descripcionActual = oldData.descripcion_mascota|default(oldData.descripcion|default(mascotaFields.descripcion|default(''))) %}
{% set fechaDB = mascotaFields.fecha_nacimiento|default('') %}
{% set fechaNacimientoActual = oldData.fecha_nacimiento|default(fechaDB) %}
{% set fotos = fotos|default([]) %}

{% block title %}Editar Mascota - PawMap{% endblock %}

{% block main_attributes %}class="perfil-container is-editing"{% endblock %}

{% block main %}
    {% if request.get('update') == 'success' %}
        <aside class="alerta-exito" role="status">
            <span class="material-symbols-outlined">check_circle</span>
            <section>
                <strong>¡Cambios guardados!</strong>
                <p>La mascota se ha actualizado correctamente.</p>
            </section>
        </aside>
    {% endif %}

    {% if request.get('delete') == 'success' %}
        <aside class="alerta-exito" role="status">
            <span class="material-symbols-outlined">check_circle</span>
            <section>
                <strong>¡Foto eliminada!</strong>
                <p>La foto se ha eliminado correctamente.</p>
            </section>
        </aside>
    {% endif %}

    {% if request.get('error') is not null %}
        <aside class="alerta-error" role="alert">
            <span class="material-symbols-outlined">error</span>
            <section>
                <strong>Ocurrió un inconveniente</strong>
                {% if request.get('error') == 'foto_no_encontrada' %}
                    <p>La foto ya fue eliminada o no se pudo encontrar.</p>
                {% else %}
                    <p>Ocurrió un error al guardar los cambios. Intentalo de nuevo.</p>
                {% endif %}
            </section>
        </aside>
    {% endif %}

    <section class="perfil-datos perfil-datos-unificada">
        <form id="form-editar-mascota" method="POST" action="/mascota/editar/guardar" enctype="multipart/form-data" novalidate>
            <header class="perfil-datos-header">
                <h2>Editar Mascota</h2>
            </header>

        <input type="hidden" name="id" value="{{ mascotaFields.id|default('') }}">

        <ul class="perfil-datos-grid">
            <li class="dato-item">
                <span class="dato-label">Nombre *</span>
                <input type="text" name="nombre" value="{{ nombreActual }}" class="dato-valor-input input-value {{ errores.nombre is defined ? 'input-invalido' : '' }}" minlength="2" maxlength="60" pattern="^[A-Za-zÁÉÍÓÚáéíóúÑñ\s'-]+$" required data-trim-required="true" title="Solo se permiten letras, espacios, apóstrofes y guiones.">
                {% if errores.nombre is defined %}
                    <span class="msg-error">{{ errores.nombre }}</span>
                {% endif %}
            </li>

            <li class="dato-item">
                <span class="dato-label">Especie *</span>
                <select name="especie" class="dato-valor-input input-value {{ errores.especie is defined ? 'input-invalido' : '' }}" required>
                    <option value="">Seleccioná una especie</option>
                    {% for e in especies %}
                        {% set especieValor = e.fields.especie|default('') %}
                        <option value="{{ especieValor }}" {{ (especieActual == especieValor|lower) ? 'selected' : '' }}>
                            {{ especieValor|capitalize }}
                        </option>
                    {% endfor %}
                    <option value="otro" {{ (especieActual == 'otro') ? 'selected' : '' }}>Otro...</option>
                </select>
                <input type="text" id="nueva_especie" name="nueva_especie" class="dato-valor-input input-value input-otro" placeholder="Escribí la nueva especie" value="{{ mascota.nueva_especie|default('') }}"
                       pattern="^[A-Za-zÁÉÍÓÚáéíóúÑñ\s]+$"
                       title="Solo se permiten letras y espacios.">
                {% if errores.especie is defined %}
                    <span class="msg-error">{{ errores.especie }}</span>
                {% endif %}
            </li>

            <li class="dato-item">
                <span class="dato-label">Tamaño *</span>
                <select name="tamanio" class="dato-valor-input input-value {{ errores.tamanio is defined ? 'input-invalido' : '' }}" required>
                    <option value="">Seleccioná un tamaño</option>
                    <option value="pequeño" {{ (tamanioActual == 'pequeño') ? 'selected' : '' }}>Pequeño</option>
                    <option value="mediano" {{ (tamanioActual == 'mediano') ? 'selected' : '' }}>Mediano</option>
                    <option value="grande" {{ (tamanioActual == 'grande') ? 'selected' : '' }}>Grande</option>
                </select>
                {% if errores.tamanio is defined %}
                    <span class="msg-error">{{ errores.tamanio }}</span>
                {% endif %}
            </li>

            <li class="dato-item">
                <span class="dato-label">Temperamento *</span>
                <select name="temperamento" class="dato-valor-input input-value {{ errores.temperamento is defined ? 'input-invalido' : '' }}" required>
                    <option value="">Seleccioná un temperamento</option>
                    {% for t in temperamentos %}
                        {% set temperamentoValor = t.fields.temperamento|default('') %}
                        <option value="{{ temperamentoValor }}" {{ (temperamentoActual == temperamentoValor|lower) ? 'selected' : '' }}>
                            {{ temperamentoValor|capitalize }}
                        </option>
                    {% endfor %}
                    <option value="otro" {{ (temperamentoActual == 'otro') ? 'selected' : '' }}>Otro...</option>
                </select>
                <input type="text" id="nuevo_temperamento" name="nuevo_temperamento" class="dato-valor-input input-value input-otro" placeholder="Escribí el nuevo temperamento" value="{{ mascota.nuevo_temperamento|default('') }}"
                       pattern="^[A-Za-zÁÉÍÓÚáéíóúÑñ\s]+$"
                       title="Solo se permiten letras y espacios.">
                {% if errores.temperamento is defined %}
                    <span class="msg-error">{{ errores.temperamento }}</span>
                {% endif %}
            </li>

            <li class="dato-item">
                <span class="dato-label">Sexo *</span>
                <label>
                    <input type="radio" name="sexo" value="macho" required {{ (sexoActual == 'macho') ? 'checked' : '' }}>
                    Macho
                </label>
                <label>
                    <input type="radio" name="sexo" value="hembra" required {{ (sexoActual == 'hembra') ? 'checked' : '' }}>
                    Hembra
                </label>
                {% if errores.sexo is defined %}
                    <span class="msg-error">{{ errores.sexo }}</span>
                {% endif %}
            </li>

            <li class="dato-item">
                <span class="dato-label">¿Está esterilizado? *</span>
                <label>
                    <input type="radio" name="esterilizado" value="si" required {{ (esterilizadoActual == 'si') ? 'checked' : '' }}>
                    Sí
                </label>
                <label>
                    <input type="radio" name="esterilizado" value="no" required {{ (esterilizadoActual == 'no') ? 'checked' : '' }}>
                    No
                </label>
                {% if errores.esterilizado is defined %}
                    <span class="msg-error">{{ errores.esterilizado }}</span>
                {% endif %}
            </li>

            <li class="dato-item">
                <span class="dato-label">Descripción</span>
                <textarea name="descripcion_mascota" class="dato-valor-input input-value {{ errores.descripcion_mascota is defined ? 'input-invalido' : '' }}" maxlength="500" rows="1">{{ descripcionActual }}</textarea>
                {% if errores.descripcion_mascota is defined %}
                    <span class="msg-error">{{ errores.descripcion_mascota }}</span>
                {% endif %}
            </li>

            <li class="dato-item">
                <span class="dato-label">Fecha de nacimiento</span>
                <input type="date" name="fecha_nacimiento" value="{{ fechaNacimientoActual }}" max="{{ 'now'|date('Y-m-d') }}" min="{{ '-30 years'|date('Y-m-d') }}" data-no-future="true" data-future-message="La fecha de nacimiento no puede ser futura." class="dato-valor-input input-value {{ errores.fecha_nacimiento is defined ? 'input-invalido' : '' }}">
                {% if errores.fecha_nacimiento is defined %}
                    <span class="msg-error">{{ errores.fecha_nacimiento }}</span>
                {% endif %}
            </li>

            <li class="dato-item">
                <span class="dato-label">Foto Principal</span>
                <span class="svg-input-row">
                    <input type="file" name="foto" accept="image/*" class="dato-valor-input input-value input-file-padding {{ errores.foto is defined ? 'input-invalido' : '' }}" data-max-file-size="2097152" data-max-file-message="La imagen no puede superar 2 MB.">
                </span>
                {% set foto_actual = mascotaFields.imagen|default('') %}
                {% if foto_actual is not empty and foto_actual != 'default-pet.jpg' and foto_actual != 'icon.png' %}
                    {% set imgMascotaUrl = foto_actual starts with 'http' ? foto_actual : '/assets/img/' ~ foto_actual %}
                    <ul class="galeria-grid" style="margin-top: 15px; padding: 0; overflow: hidden;">
                        <li class="foto-item" style="margin: 0;">
                            <figure>
                                <img src="{{ imgMascotaUrl }}" alt="Vista previa de foto principal" class="foto-extra-preview">
                                <figcaption>
                                    <button type="submit" form="form-eliminar-foto-principal" class="btn-eliminar-foto" title="Eliminar foto principal">Eliminar</button>
                                </figcaption>
                            </figure>
                        </li>
                    </ul>
                {% endif %}
                {% if errores.foto is defined %}
                    <span class="msg-error">{{ errores.foto }}</span>
                {% endif %}
            </li>

            <li class="dato-item">
                <span class="dato-label">Ilustración SVG</span>
                <span class="svg-input-row">
                    <input type="file" name="svg" accept="image/svg+xml,.svg" class="dato-valor-input input-value input-file-padding {{ errores.svg is defined ? 'input-invalido' : '' }}" data-file-types-message="Solo se permiten archivos .svg.">
                </span>
                {% if mascotaFields.svg|default('') is not empty %}
                    {% set svgUrl = mascotaFields.svg starts with 'http' ? mascotaFields.svg : '/assets/svg/' ~ mascotaFields.svg %}
                    <ul class="galeria-grid" style="margin-top: 15px; padding: 0; overflow: hidden;">
                        <li class="foto-item" style="margin: 0;">
                            <figure>
                                <img src="{{ svgUrl }}" alt="Vista previa SVG" class="foto-extra-preview" style="object-fit: contain; padding: 10px;">
                                <figcaption>
                                    <button type="submit" form="form-eliminar-svg" class="btn-eliminar-foto" title="Eliminar ilustración actual">Eliminar</button>
                                </figcaption>
                            </figure>
                        </li>
                    </ul>
                {% endif %}
                {% if errores.svg is defined %}
                    <span class="msg-error">{{ errores.svg }}</span>
                {% endif %}
            </li>
            <li class="dato-item">
                <label for="archivo_multimedia" class="dato-label">Fotos Adicionales</label>
                <input type="file" name="archivo_multimedia[]" id="archivo_multimedia" accept="image/*" multiple class="dato-valor-input input-file-padding">
            </li>

            <li class="dato-item">
                <footer class="perfil-datos-acciones">
                    <button type="submit" form="form-editar-mascota" class="btn-guardar-perfil">Guardar</button>
                    <a href="/perfil" class="btn-cancelar-perfil">Cancelar</a>
                </footer>
            </li>
        </ul>
    </form>

    <section class="galeria-multimedia">
        <ul class="galeria-grid">
            {% for foto in fotos %}
                <li class="foto-item">
                    <figure>
                        {% set extraUrl = foto.url starts with 'http' ? foto.url : '/' ~ foto.url %}
                        <img src="{{ extraUrl }}" alt="Foto extra de la mascota" class="foto-extra-preview">
                        <figcaption>
                            <form method="POST" action="/mascota/eliminar-foto" class="eliminar-foto-form">
                                <input type="hidden" name="id" value="{{ foto.id }}">
                                <input type="hidden" name="mascota_id" value="{{ mascotaFields.id }}">
                                <button type="submit" class="btn-eliminar-foto">Eliminar</button>
                            </form>
                        </figcaption>
                    </figure>
                </li>
            {% endfor %}
        </ul>
    </section>

    <form id="form-eliminar-svg" method="POST" action="/mascota/eliminar-svg" hidden>
        <input type="hidden" name="id" value="{{ mascotaFields.id|default('') }}">
    </form>
    
    <form id="form-eliminar-foto-principal" method="POST" action="/mascota/eliminar-foto-principal" hidden>
        <input type="hidden" name="id" value="{{ mascotaFields.id|default('') }}">
    </form>


</section>



{% endblock %}
