{% extends 'layout/base.html.twig' %}

{% block title %}Inicio - PawMap{% endblock %}

{% block head %}
    <script type="application/ld+json">
    {% set baseUrl = (request.server('REQUEST_SCHEME')|default('http')) ~ '://' ~ request.server('HTTP_HOST') %}
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "PawMap",
      "url": "{{ baseUrl }}/",
      "logo": "{{ baseUrl }}/assets/img/icon.png",
      "description": "Plataforma para conectar refugios y personas que desean adoptar mascotas en Argentina.",
      "sameAs": [
        "https://www.facebook.com/pawmap",
        "https://www.instagram.com/pawmap"
      ]
    }
    </script>
{% endblock %}

{% block main %}
    <header class="hero-inicio">
        <h1>Encuentra a tu nuevo<br>mejor amigo</h1>
        <p>Explora mascotas cerca de tu ubicación.</p>
    </header>

    <section class="seccion-mapa">
        <figure id="leaflet-map" class="mapa-interactivo" data-refugios='{{ refugiosMapa|default([])|json_encode(constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT'))|raw }}'></figure>
        <a href="/mapa" class="boton-principal boton-ancho">Ver Mapa</a>
    </section>

    <section class="seccion-incentivar-adopcion">
        
        <article class="incentivar-adopcion-movil">
            <h2 class="titulo-incentivar-adopcion">¡Encontrá tu match!</h2>
            
            <article class="tarjeta-incentivar-adopcion">
                <p>¿Qué tipo de mascota buscás?</p>
                <a href="/test-de-compatibilidad" class="boton-secundario">Realizar Test</a>
            </article>
        </article>

        <article class="incentivar-adopcion-desktop">
            <header class="cuerpo-incentivar-adopcion">
                <h2>Animate a Adoptar</h2>
            </header>
            <a href="/como-adoptar" class="boton-secundario">Guía de Adopción</a>
        </article>

    </section>

    <section class="seccion-adopcion">
        <h2>Mascotas en Adopción</h2>
        
        <section class="carrusel" data-paw-carousel data-paw-effect="zoom" data-paw-miniaturas="false">
            {% if mascotas is not empty %}
                {% for mascota in mascotas %}
                    {% if mascota.fields is defined %}
                        <article class="tarjeta-mascota">
                            <figure class="tarjeta-imagen">
                                <a href="/mascota?id={{ mascota.fields.id|default('')|escape('html_attr') }}" class="link-imagen">
                                    {% set imagenUrl = mascota.fields.imagen|default('default-pet.jpg') starts with 'http' ? mascota.fields.imagen : '/assets/img/' ~ mascota.fields.imagen|default('default-pet.jpg') %}
                                    <img src="{{ imagenUrl }}" alt="Foto de {{ mascota.fields.nombre|default('Mascota')|capitalize }}">
                                </a>
                                <form method="POST" action="/favorito" class="form-favorito-tarjeta">
                                    <input type="hidden" name="mascota_id" value="{{ mascota.fields.id|default('')|escape('html_attr') }}">
                                    <button type="submit" class="btn-favorito {{ mascota.fields.id in (favoritosIds|default([])) ? 'favorito-activo' : '' }}" aria-label="Agregar a favoritos">
                                        <span class="material-symbols-outlined">favorite</span>
                                    </button>
                                </form>
                            </figure>

                            <a href="/mascota?id={{ mascota.fields.id|default('')|escape('html_attr') }}" class="verPerfil"> 
                                <section class="tarjeta-info">
                                    <h3>{{ mascota.fields.nombre|default('')|capitalize }}</h3>
                                    <p>
                                        {{ mascota.fields.edad|default('') }} años - 
                                        {{ mascota.fields.tamano|default('')|capitalize }} - 
                                        {{ mascota.fields.temperamento|default('')|capitalize }}
                                    </p>
                                </section>
                            </a>
                        </article>
                    {% endif %}
                {% endfor %}
            {% else %}
                <p>No hay mascotas en adopción en este momento.</p>
            {% endif %}
        </section>

        <a href="/adoptar" class="boton-principal boton-centrado">Ver Todas las mascotas</a>
    </section>

    <section class="seccion-resenas">
        <header>
            <h2>Lo que dicen nuestros adoptantes</h2>
        </header>

        <section class="carrusel" data-paw-carousel data-paw-effect="zoom" data-paw-miniaturas="false">
            {% if resenas is defined and resenas is not empty %}
                {% for resena in resenas %}
                    <article class="tarjeta-resena">
                        <figure class="perfil-autor">
                            {% if resena.adoptante_foto is not empty %}
                                {% set resenaImg = resena.adoptante_foto starts with 'http' ? resena.adoptante_foto : '/assets/img/' ~ resena.adoptante_foto %}
                                <img src="{{ resenaImg }}" alt="Foto de {{ resena.adoptante_nombre }}">
                            {% else %}
                                <span class="material-symbols-outlined avatar-placeholder">account_circle</span>
                            {% endif %}
                            <figcaption>
                                <h3>{{ resena.adoptante_nombre }}</h3>
                                <p>Adoptó a <strong>{{ resena.mascota_nombre }}</strong></p>
                            </figcaption>
                        </figure>
                        <aside class="calificacion-estrellas">
                            {% for i in 1..5 %}
                                {% if i <= resena.calificacion %}
                                    <span class="material-symbols-outlined star-llena">star</span>
                                {% else %}
                                    <span class="material-symbols-outlined star-vacia">star_border</span>
                                {% endif %}
                            {% endfor %}
                        </aside>
                        <blockquote>
                            <p>{{ resena.comentario }}</p>
                        </blockquote>
                    </article>
                {% endfor %}
            {% else %}
                <p class="sin-resenas-mensaje">Todavía no hay reseñas. ¡Sé el primero en adoptar y contarnos tu experiencia!</p>
            {% endif %}
        </section>

        {% if adopcionesSinResena is defined and adopcionesSinResena|length > 0 %}
            <aside class="acciones-resena">
                <button type="button" class="boton-principal" id="btn-abrir-modal-resena">Dejar Reseña</button>
            </aside>

            <dialog id="modal-resena" class="modal-resena">
                <article class="tarjeta-resena nueva-resena" data-paw-resena-form>
                    <button type="button" id="btn-cerrar-modal-resena" class="modal-resena-close"><span class="material-symbols-outlined">close</span></button>
                    <form action="/resena/guardar" method="POST" id="form-nueva-resena">
                        <fieldset>
                            <legend>¡Dejá tu reseña sobre tu adopción!</legend>
                            
                            <label for="mascota_id">Selecciona a quién vas a reseñar:</label>
                            <select name="mascota_id" id="mascota_id" required data-resena-select>
                                {% for adopcion in adopcionesSinResena %}
                                    <option value="{{ adopcion.mascota_id }}" data-refugio="{{ adopcion.refugio_id }}">{{ adopcion.mascota_nombre }}</option>
                                {% endfor %}
                            </select>
                            
                            <input type="hidden" name="refugio_id" id="refugio_id" value="{{ adopcionesSinResena[0].refugio_id }}">

                            <label>Calificación:</label>
                            <fieldset class="rating-stars" data-resena-stars>
                                <input type="radio" id="star5" name="calificacion" value="5" required />
                                <label for="star5" title="5 estrellas" class="material-symbols-outlined">star</label>
                                
                                <input type="radio" id="star4" name="calificacion" value="4" />
                                <label for="star4" title="4 estrellas" class="material-symbols-outlined">star</label>
                                
                                <input type="radio" id="star3" name="calificacion" value="3" />
                                <label for="star3" title="3 estrellas" class="material-symbols-outlined">star</label>
                                
                                <input type="radio" id="star2" name="calificacion" value="2" />
                                <label for="star2" title="2 estrellas" class="material-symbols-outlined">star</label>
                                
                                <input type="radio" id="star1" name="calificacion" value="1" />
                                <label for="star1" title="1 estrella" class="material-symbols-outlined">star</label>
                            </fieldset>

                            <label for="comentario">Comentario:</label>
                            <textarea id="comentario" name="comentario" required minlength="10" maxlength="150" placeholder="Contanos tu experiencia..."></textarea>

                            <button type="submit" class="boton-principal">Publicar Reseña</button>
                        </fieldset>
                    </form>
                </article>
            </dialog>

        {% endif %}
    </section>
{% endblock %}
