{% extends 'layout/base.html.twig' %}

{% block title %}{{ mascota.fields.nombre|default('Mascota') }} - PawMap{% endblock %}

{% block head %}
    <link rel="stylesheet" href="/assets/css/pawcarousel.css" />
{% endblock %}

{% block main %}
    <article class="seccion-detalle-mascota">
        <section class="galeria-mascota">
            <figure class="imagen-principal-desktop">
                {% set imagenUrl = mascota.fields.imagen|default('default-pet.jpg') starts with 'http' ? mascota.fields.imagen : '/assets/img/' ~ mascota.fields.imagen|default('default-pet.jpg') %}
                <img src="{{ imagenUrl }}" alt="{{ mascota.fields.nombre|default('Mascota') }}">
            </figure>

            {% if mediaExtras is not empty %}
                <h4>GALERÍA</h4>
            {% endif %}

            <section class="carrusel-mascota" data-paw-carousel data-paw-effect="zoom" data-paw-miniaturas="false">
                
                <figure class="carrusel-slide-item slide-principal-movil">
                    {% set imagenUrl = mascota.fields.imagen|default('default-pet.jpg') starts with 'http' ? mascota.fields.imagen : '/assets/img/' ~ mascota.fields.imagen|default('default-pet.jpg') %}
                    <img src="{{ imagenUrl }}"
                         alt="{{ mascota.fields.nombre|default('Mascota') }}">
                </figure>

                {% if mediaExtras is not empty %}
                    {% for media in mediaExtras %}
                        <figure class="carrusel-slide-item">
                            {% set extraUrl = media.url starts with 'http' ? media.url : '/' ~ media.url %}
                            {% if media.tipo == 'video' %}
                                <video controls loading="lazy">
                                    <source src="{{ extraUrl }}" type="video/mp4">
                                    Tu navegador no soporta videos.
                                </video>
                            {% else %}
                                <img src="{{ extraUrl }}" loading="lazy"
                                     alt="Media extra de {{ mascota.fields.nombre|default('Mascota') }}">
                            {% endif %}
                        </figure>
                    {% endfor %}
                {% endif %}
            </section>
        </section>

        <aside class="info-mascota">
            <span class="drag-handle"></span>
            <header class="info-header">
                <h2>{{ mascota.fields.nombre|default('Mascota') }}</h2>
                {% set svgArchivo = mascota.fields.svg|default('')|trim %}
                {% if svgArchivo is empty %}
                    {# Retrocompatibilidad: mascotas antiguas sin campo svg usan el nombre #}
                    {% set svgArchivo = mascota.fields.nombre|default('')|trim|lower ~ '.svg' %}
                {% endif %}
                {% if svgArchivo is not empty %}
                <figure class="svg-mascota">
                    {% set svgUrl = svgArchivo starts with 'http' ? svgArchivo : '/assets/svg/' ~ svgArchivo %}
                    <img src="{{ svgUrl }}"
                         alt="Animación de {{ mascota.fields.nombre|default('') }}"
                         class="svg-mascota-img"
                         onerror="this.parentElement.style.display='none'">
                </figure>
            {% endif %}
                <a href="mascota/libreta?id={{ mascota.fields.id|default('') }}" class="libreta">
                    <span class="material-symbols-outlined">clinical_notes</span>
                </a>
                <form method="POST" action="/favorito" class="form-favorito">
                    <input type="hidden" name="mascota_id" value="{{ mascota.fields.id|default('') }}">
                    <button type="submit" class="boton-favorito {{ esFavorito is defined and esFavorito ? 'favorito-activo' : '' }}" aria-label="Agregar a favoritos">
                        <span class="material-symbols-outlined">favorite</span>
                    </button>
                </form>

                {# Botón compartir con dropdown (a la derecha del corazón) #}
                <nav class="compartir-wrapper"
                     data-nombre="{{ mascota.fields.nombre|default('esta mascota') }}"
                     data-especie="{{ mascota.fields.especie|default('animal')|capitalize }}">
                    <button type="button" class="boton-compartir" aria-label="Compartir" aria-expanded="false">
                        <span class="material-symbols-outlined">ios_share</span>
                    </button>
                    <menu class="compartir-dropdown" hidden>
                        <li>
                            <a class="compartir-opcion compartir-wpp" href="#" target="_blank" rel="noopener noreferrer">
                                <img src="/assets/svg/whatsapp.svg" alt="WhatsApp" class="icono-redes">
                                WhatsApp
                            </a>
                        </li>
                        <li>
                            <button type="button" class="compartir-opcion compartir-ig">
                                <img src="/assets/svg/instagram.svg" alt="Instagram" class="icono-redes">
                                Instagram
                            </button>
                        </li>
                        <li>
                            <button type="button" class="compartir-opcion compartir-tt">
                                <img src="/assets/svg/tiktok.svg" alt="TikTok" class="icono-redes">
                                TikTok
                            </button>
                        </li>
                    </menu>
                </nav>
            </header>

            {% set esp = mascota.fields.especie|default('Desconocido')|capitalize %}

            <p class="info-subtitulo">
                {{ esp }} •
                {{ ubicacionTexto|default('Ubicación a confirmar') }}
            </p>

            <section class="estadisticas-mascota">
                <article class="estadistica-box">
                    <span class="estadistica-label">Edad</span>
                    <span class="estadistica-valor">{{ mascota.fields.edad|default('?') }} años</span>
                </article>
                <article class="estadistica-box">
                    <span class="estadistica-label">Tamaño</span>
                    <span class="estadistica-valor">{{ mascota.fields.tamano|default('?')|capitalize }}</span>
                </article>
                <article class="estadistica-box">
                    <span class="estadistica-label">Sexo</span>
                    <span class="estadistica-valor">{{ mascota.fields.sexo|default('?')|capitalize }}</span>
                </article>
            </section>

            <section class="etiquetas-mascota">
                <h4>Etiquetas</h4>
                <ul class="etiquetas-container">
                    <li class="etiqueta">{{ mascota.fields.temperamento|default('Juguetón')|capitalize }}</li>
                    <li class="etiqueta">Ideal Depto</li>
                    <li class="etiqueta">Convive con Gatos</li>
                </ul>
            </section>

            <section class="sobre-mi">
                <h4>SOBRE MÍ</h4>
                <p class="sobre-mi-box">{{ mascota.fields.descripcion|default('Sin descripción disponible.') }}</p>
            </section>

            <a href="/refugio/perfil?id={{ refugio.fields.usuario_id|default(refugio.fields.id) }}" class="refugio-info">
                {% set refugioImgUrl = refugio.fields.imagen|default('default-refugio.jpg') starts with 'http' ? refugio.fields.imagen : '/assets/img/' ~ refugio.fields.imagen|default('default-refugio.jpg') %}
                <img src="{{ refugioImgUrl }}"
                     alt="Logo refugio" class="img-refugio">
                <figcaption class="refugio-texto">
                    <span class="refugio-label">A cargo de:</span>
                    <strong>{{ refugio.fields.nombre_institucion|default('Desconocido') }}</strong>
                </figcaption>
            </a>


            <a href="/formulario-adopcion?id={{ mascota.fields.id|default('') }}" class="boton-adoptar">¡QUIERO ADOPTAR!</a>
        </aside>
    </article>
{% endblock %}

{% block scripts %}
    <script src="/assets/js/mascota.js"></script>
    <script>
    (function () {
        var wrapper = document.querySelector('.compartir-wrapper');
        if (!wrapper) return;

        var nombre  = wrapper.dataset.nombre;
        var especie = wrapper.dataset.especie;
        var url     = window.location.href;
        var msg     = '¡Mirá a ' + nombre + ' buscando hogar! Es un/a ' + especie + ' en adopción en PawMap. \nEntrá acá para conocerlo/a mejor:\n' + url;
        var btn      = wrapper.querySelector('.boton-compartir');
        var dropdown = wrapper.querySelector('.compartir-dropdown');

        // Abrir/cerrar dropdown
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var abierto = !dropdown.hidden;
            dropdown.hidden = abierto;
            btn.setAttribute('aria-expanded', String(!abierto));
        });

        // Cerrar al hacer click afuera
        document.addEventListener('click', function () {
            dropdown.hidden = true;
            btn.setAttribute('aria-expanded', 'false');
        });
        dropdown.addEventListener('click', function (e) { e.stopPropagation(); });

        // WhatsApp
        var wppLink = wrapper.querySelector('.compartir-wpp');
        wppLink.href = 'https://wa.me/?text=' + encodeURIComponent(msg);

        function abrirApp(label, appUrl) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(msg).then(function () {
                    mostrarToast('¡Mensaje copiado! Abriendo ' + label + '... 📋');
                    setTimeout(function() {
                        window.open(appUrl, '_blank');
                    }, 1500);
                }).catch(function () {
                    mostrarToast('No se pudo copiar (requiere HTTPS). URL: ' + url);
                    window.open(appUrl, '_blank');
                });
            } else {
                mostrarToast('No se pudo copiar automáticamente.');
                window.open(appUrl, '_blank');
            }
            dropdown.hidden = true;
            btn.setAttribute('aria-expanded', 'false');
        }

        wrapper.querySelector('.compartir-ig').addEventListener('click', function (e) { 
            e.preventDefault();
            abrirApp('Instagram', 'https://instagram.com'); 
        });
        wrapper.querySelector('.compartir-tt').addEventListener('click', function (e) { 
            e.preventDefault();
            abrirApp('TikTok', 'https://tiktok.com'); 
        });

        function mostrarToast(texto) {
            var toast = document.createElement('div');
            toast.className = 'compartir-toast';
            toast.textContent = texto;
            document.body.appendChild(toast);
            setTimeout(function () { toast.classList.add('compartir-toast--visible'); }, 10);
            setTimeout(function () {
                toast.classList.remove('compartir-toast--visible');
                setTimeout(function () { toast.remove(); }, 400);
            }, 3000);
        }
    })();
    </script>
{% endblock %}
