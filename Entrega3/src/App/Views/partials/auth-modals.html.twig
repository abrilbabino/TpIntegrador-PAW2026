{% set error = request.get('error') %}
{% set auth = request.get('auth') %}
{% set registro = request.get('registro') %}

<dialog id="modal-login" class="modal-auth">
    <section class="modal-auth-content">
        <header class="sesion-header">
            <h1>Iniciar Sesión</h1>
            <figure class="avatar">
                <img src="/assets/img/icon.png" alt="Logo PawMap">
            </figure>
            <form method="dialog" class="auth-close-form">
                <button type="submit" class="auth-close-btn" aria-label="Cerrar modal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </form>
        </header>

        <form class="login-form" method="POST" action="/login">
            <label for="nombre_usuario">Usuario</label>
            <input
                type="text"
                id="nombre_usuario"
                name="nombre_usuario"
                placeholder="Ingresá tu usuario"
                {{ error == 'campos' ? 'data-server-error="Por favor completá todos los campos obligatorios."' : '' }}
                {{ error == '1' ? 'class="input-invalido"' : '' }}
                required
            />

            <label for="contrasena">Contraseña</label>
            <fieldset class="campo-contraseña">
                <input
                    type="password"
                    id="contrasena"
                    name="contrasena"
                    placeholder="Ingresá tu contraseña"
                    {{ error == '1' ? 'data-server-error="Usuario o contraseña incorrectos."' : '' }}
                    required
                />
                <span class="material-symbols-outlined simbolos mostrar-contraseña">visibility_off</span>
            </fieldset>

            <button type="submit" class="btn-auth">Iniciar Sesión</button>
        </form>
        <p class="auth-switch">
            ¿No tenes cuenta aún?
            <button type="button" class="btn-link" id="btn-switch-register">Registrate aquí</button>
        </p>
    </section>
</dialog>

<dialog id="modal-register" class="modal-auth">
    <section class="modal-auth-content">
        <header class="registro-header">
            <h2>Registrarme</h2>
            <form method="dialog" class="auth-close-form">
                <button type="submit" class="auth-close-btn" aria-label="Cerrar modal">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </form>
        </header>

        <form class="registro-form" method="POST" action="/register">
            <label for="name" id="label-name">Nombre</label>
            <input type="text" id="name" name="name" placeholder="Ingresá tu nombre" pattern="[A-Za-záéíóúÁÉÍÓÚñÑ\s]+" title="Solo se permiten letras y espacios" required />

            <label for="apellido" class="adoptante-field {% if registro == 'refugio' %}oculto{% endif %}">Apellido</label>
            <input type="text" id="apellido" name="apellido" class="adoptante-field {% if registro == 'refugio' %}oculto{% endif %}" placeholder="Ingresá tu apellido" pattern="[A-Za-záéíóúÁÉÍÓÚñÑ\s]+" title="Solo se permiten letras y espacios" {% if registro != 'refugio' %}required{% endif %} />

            <label for="dni" class="adoptante-field {% if registro == 'refugio' %}oculto{% endif %}">DNI</label>
            <input type="text" id="dni" name="dni" class="adoptante-field {% if registro == 'refugio' %}oculto{% endif %}" placeholder="Ingresá tu DNI" pattern="[0-9]{7,8}" minlength="7" maxlength="8" title="Debe ingresar exactamente 7 u 8 cifras (por ejemplo: 12345678)" {% if registro != 'refugio' %}required{% endif %} />

            <label for="fecha_nacimiento" class="adoptante-field {% if registro == 'refugio' %}oculto{% endif %}">Fecha de nacimiento</label>
            <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" class="adoptante-field {% if registro == 'refugio' %}oculto{% endif %}" max="{{ '-18 years'|date('Y-m-d') }}" title="Debes ser mayor de 18 años para registrarte" {% if registro != 'refugio' %}required{% endif %} />

            <label for="mail">Correo Electrónico</label>
            <input
                type="email"
                id="mail"
                name="email"
                placeholder="Ingresá tu correo electrónico"
                {{ error == 'email_existente' ? 'data-server-error="El email ingresado ya está registrado."' : '' }}
                required
            />

            <label for="user-register">Usuario</label>
            <input
                type="text"
                id="user-register"
                name="username"
                placeholder="Ingresá un usuario"
                {{ error == 'usuario_existente' ? 'data-server-error="El nombre de usuario ya está en uso."' : '' }}
                required
            />

            <label for="pass-register">Contraseña</label>
            <fieldset class="campo-contraseña">
                <input
                    type="password"
                    id="pass-register"
                    name="password"
                    placeholder="Ingresá tu contraseña"
                    required
                />
                <span class="material-symbols-outlined simbolos mostrar-contraseña">visibility_off</span>
            </fieldset>

            <label for="rol">Tipo de cuenta</label>
            <select id="rol" name="rol" required class="registro-input">
                <option value="adoptante" {{ (registro is null or registro != 'refugio') ? 'selected' : '' }}>Quiero adoptar una mascota</option>
                <option value="refugio" {{ (registro is not null and registro == 'refugio') ? 'selected' : '' }}>Soy un refugio / protectora</option>
            </select>

            <button type="submit" class="btn-auth">Registrarme</button>
        </form>
    </section>
</dialog>
