<header class="Barra-navegacion">
    <figure class="header-logo">
        <a href="/">
            <img src="/assets/img/logo.png" alt="Inicio" />
        </a>
    </figure>

    <form action="/buscar" method="GET" class="header-busqueda" data-paw-busquedas>
        <input type="search" id="busqueda" name="busqueda" placeholder="Buscar..." class="busqueda-input" value="{{ request.get('busqueda')|default('') }}" autocomplete="off" />
    </form>
    
    {% if session.user is defined %}
        <section class="nav-acciones-usuario">
            <a href="/perfil" class="icono-usuario">
                {% if session.user.foto_perfil is defined and session.user.foto_perfil %}
                    <img src="/assets/img/{{ session.user.foto_perfil }}" alt="Perfil" class="nav-foto-perfil">
                {% else %}
                    <span class="material-symbols-outlined">person</span>
                {% endif %}
                <p>Perfil</p>
            </a>
        </section>
    {% else %}
        <a href="/iniciar-sesion" class="icono-usuario">
            <span class="material-symbols-outlined">person</span>
            <p>Iniciar Sesión</p>
        </a>
    {% endif %}

    <nav class="menu-principal">
        <ul class="nav-lista">
            {% for item in menu %}
                <li class="{{ item.li_class|default('') }}">
                    {% if item.type|default('') == 'link' %}
                        <a href="{{ item.href }}" class="nav-link {{ item.class|default('') }}">
                            {% if item.icon is defined %}<span class="material-symbols-outlined simbolos">{{ item.icon }}</span>{% endif %}
                            {{ item.name }}
                        </a>
                    {% elseif item.type|default('') == 'label' %}
                        <label for="{{ item.for|default('') }}" class="nav-link">
                            {% if item.icon is defined %}<span class="material-symbols-outlined simbolos">{{ item.icon }}</span>{% endif %}
                            {{ item.name }}
                        </label>
                    {% else %}
                        <span class="nav-link">{{ item.name }}</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </nav>
</header>
