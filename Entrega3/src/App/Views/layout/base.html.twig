<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="description" content="{{ metaDescription|default('PawMap: Encuentra a tu compañero ideal. Adopta perros y gatos en adopción de los mejores refugios.') }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/img/icon.png?v=2">
    <link rel="stylesheet" href="/assets/css/style.css" />
    <link rel="stylesheet" href="/assets/css/pawcarousel.css" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
    />
    <title>{% block title %}PawMap{% endblock %}</title>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin="" defer></script>
    <script src="/assets/js/components/paw.js"></script>
    <script src="/assets/js/app.js"></script>
    {% block head %}{% endblock %}
</head>
  <body>
    {% include 'partials/barra-navegacion.html.twig' %}
    
    {% block content_before_main %}{% endblock %}

    <main {% block main_attributes %}{% endblock %}>
        {% block main %}{% endblock %}
    </main>

    {% include 'partials/footer.html.twig' %}

    {% block content_after_main %}{% endblock %}
    {% block scripts %}{% endblock %}
  </body>
</html>
